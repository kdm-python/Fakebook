# Local defaults. Copy this file to backend/.env only when you need overrides.
FAKEBOOK_APP_NAME="Python Exercise Runner"
FAKEBOOK_HOST="127.0.0.1"
FAKEBOOK_PORT=8000
FAKEBOOK_FORWARDED_ALLOW_IPS="127.0.0.1"
FAKEBOOK_RUN_TIMEOUT_SECONDS=60
FAKEBOOK_MAX_OUTPUT_BYTES=100000

# Optional absolute paths:
# FAKEBOOK_FRONTEND_DIR="/absolute/path/to/frontend"
# FAKEBOOK_EXERCISE_DIR="/absolute/path/to/backend/exercises"
