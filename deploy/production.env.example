# Installed as /etc/fakebook/backend.env by deploy.sh.
FAKEBOOK_APP_NAME="Python Exercise Runner"
FAKEBOOK_HOST="0.0.0.0"
FAKEBOOK_PORT=8000
FAKEBOOK_FORWARDED_ALLOW_IPS="192.0.2.10"
FAKEBOOK_RUN_TIMEOUT_SECONDS=60
FAKEBOOK_MAX_OUTPUT_BYTES=100000

# Placeholders for your final LXC layout, if it differs from the defaults:
FAKEBOOK_FRONTEND_DIR="/opt/fakebook/app/frontend"
FAKEBOOK_EXERCISE_DIR="/opt/fakebook/app/backend/exercises"

# Reference values for your notes; the application does not use these yet:
PUBLIC_URL="https://python.example.com"
MAIN_NGINX_LXC_IP="192.0.2.10"
